# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials. Only EXPO_PUBLIC_* vars are safe here: Expo inlines
# them into the client bundle at build time, so nothing prefixed this way can
# be a secret (the anon key is designed to be public; RLS protects the data).
# The service_role key must NEVER go in this file or anywhere in the app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
